# Public half of `php artisan sos:platform-keys` — used to reject forged envelopes.
PLATFORM_PUBLIC_KEY=
# Server and a relay token from `php artisan sos:edge-token <institution-short-code> "<location name>"`
API_URL=https://sos.example.com
API_TOKEN=
NODE_NAME=Library-AP-1
DATA_FILE=./edge-store.json
