{
  "name": "sos-connect-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "test": "jest"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@msgpack/msgpack": "^3.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.0",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image-picker": "~17.0.0",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.8",
    "expo-sms": "~14.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-task-manager": "~14.0.0",
    "laravel-echo": "^2.1.0",
    "pusher-js": "^8.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-tcp-socket": "^6.3.0",
    "react-native-udp": "^4.1.7",
    "react-native-webrtc": "^124.0.7",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^mesh-nearby$": "<rootDir>/modules/mesh-nearby/src"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/modules/"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ]
  }
}
