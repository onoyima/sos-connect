APP_NAME="SOS Connect"
# Local defaults: works with only `php artisan serve` + XAMPP MySQL.
# For the live server see docs/deployment.md: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain, SESSION_SECURE_COOKIE=true.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Our own database. Institution databases are NEVER connected here — only through their connector.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sos_connect
DB_USERNAME=root
DB_PASSWORD=

# Platform operator account created by `php artisan migrate --seed` (password printed if left blank)
SEED_PLATFORM_ADMIN_EMAIL=admin@sos.example.com
SEED_PLATFORM_ADMIN_PASSWORD=
SOS_ALLOW_DIRECT_DB=true
# Rate limits block people only in production. Set true to test them locally.
SOS_RATE_LIMITS=

SESSION_DRIVER=database
# Minutes without use before the website signs you out (43200 = 30 days, like WhatsApp Web).
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
# The site's own address is always accepted for its API calls; list extra addresses here only if you need them.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000

CACHE_STORE=database
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Realtime (Laravel Reverb)
# Local only: lets the connector run on http://127.0.0.1:9000. Keep true (https only) on a real server.
SOS_CONNECTOR_REQUIRE_HTTPS=false
# Connectors on private addresses (10.x, 192.168.x, localhost) are refused unless this is true.
SOS_CONNECTOR_ALLOW_PRIVATE=false

# Security (docs/security.md). CSP: enforce | report | off. Sign-in limits are failures per hour.
SECURITY_CSP=enforce
SECURITY_LOGIN_PER_ACCOUNT=15
SECURITY_LOGIN_PER_IP=40

# 'log' = no websocket server needed (pages update on refresh). Use 'reverb' + `php artisan reverb:start` for live updates.
# Live updates (chats, SOS, calls). `php artisan sos:realtime-setup` fills these in; `php artisan sos:serve` starts it.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Only if browsers/phones reach the websocket server at a different address (e.g. behind a proxy on 443):
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Device certificates (php artisan sos:platform-keys)
SOS_PLATFORM_SIGN_SECRET=
SOS_PLATFORM_SIGN_PUBLIC=
SOS_CERTIFICATE_DAYS=30

# Calls (coturn with use-auth-secret)
TURN_HOST=turn.sos.example.com
TURN_SECRET=

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sos.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shown in the legal pages
SOS_OPERATOR_NAME="SOS Connect Ltd"
SOS_OPERATOR_ADDRESS="[Registered address, Nigeria]"
SOS_DPO_EMAIL=dpo@sos.example.com
